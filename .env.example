# =============================================================================
# ZShield Dashboard — variables d'environnement
# Copier en .env. Ne jamais committer .env.
# Tous les secrets viennent d'ici : aucun secret n'est écrit dans le code ni
# stocké en base en clair.
# =============================================================================

NODE_ENV=development
LOG_LEVEL=info
PORT=4000

# Origines autorisées pour le frontend. Liste explicite, jamais "*".
CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL --------------------------------------------------------------
# Le rôle applicatif doit être NOBYPASSRLS et sans privilège DDL.
DATABASE_URL=postgres://zshield_app:devpassword@localhost:5432/zshield
# Rôle distinct pour les migrations (DDL).
DATABASE_MIGRATION_URL=postgres://zshield_migrator:devpassword@localhost:5432/zshield
DATABASE_POOL_MAX=10

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Clés applicatives -------------------------------------------------------
# 32 octets en base64. Générer avec :  openssl rand -base64 32
# Chiffre les secrets HMAC des agents et les secrets TOTP (AES-256-GCM).
# La perdre rend toutes les credentials d'agent illisibles : les opérateurs
# devront en générer de nouvelles. La sauvegarder séparément de la base.
ZSHIELD_CREDENTIAL_KEY=

# Signe les cookies de session. Rotation possible : ancienne clé en second.
SESSION_SECRET=
SESSION_SECRET_PREVIOUS=

# --- Front & connexion Discord ----------------------------------------------
# Origine publique du tableau de bord (sert aux redirections OAuth). Vide en dev
# = déduite de la requête.
WEB_ORIGIN=http://localhost:3000

# Connexion « Continuer avec Discord ». Tout reste désactivé (le bouton affiche
# un message honnête) tant que DISCORD_LOGIN_ENABLED n'est pas « true » AVEC les
# trois valeurs ci-dessous. Créez l'application sur https://discord.com/developers,
# ajoutez l'URL de redirection ci-dessous dans OAuth2 > Redirects, scopes
# `identify` + `email`.
DISCORD_LOGIN_ENABLED=false
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:4000/api/auth/discord/callback

# --- Protocole agent ---------------------------------------------------------
# Tolérance d'écart d'horloge, en secondes. Le protocole impose 300 ; élargir
# affaiblit chaque requête, réduire casse les serveurs mal synchronisés.
AGENT_CLOCK_SKEW_SECONDS=300
# Durée de conservation des nonces. Doit être >= 2x la tolérance d'horloge.
AGENT_NONCE_TTL_SECONDS=900
# Limite de débit par agent, requêtes par minute.
AGENT_RATE_LIMIT_PER_MINUTE=120
